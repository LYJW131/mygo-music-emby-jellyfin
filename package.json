  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
